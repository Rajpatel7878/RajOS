# ==============================================================================
# RajOS — Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ==============================================================================

# -----------------------------------------------
# Application
# -----------------------------------------------
APP_NAME=RajOS
APP_VERSION=2.0.0
DEBUG=false

# -----------------------------------------------
# Security (REQUIRED in production)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# -----------------------------------------------
SECRET_KEY=CHANGE_THIS_IN_PRODUCTION_USE_A_LONG_RANDOM_SECRET_KEY
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# -----------------------------------------------
# Database
# SQLite (default):   sqlite:///./rajos.db
# PostgreSQL example: postgresql://user:password@localhost:5432/rajos
# -----------------------------------------------
DATABASE_URL=sqlite:///./rajos.db

# -----------------------------------------------
# CORS — comma-separated allowed frontend origins
# Development: http://localhost:3000,http://127.0.0.1:3000
# Production:  https://rajos.app,https://www.rajos.app
# -----------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# -----------------------------------------------
# LLM Providers
# Set DEFAULT_LLM_PROVIDER to the provider you have a key for.
# Options: gemini | openai | local
# -----------------------------------------------
DEFAULT_LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash

# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# -----------------------------------------------
# Google OAuth (backend — optional)
# Set these if you configure FastAPI-side Google OAuth.
# Do NOT put these in the frontend .env.
# -----------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------
# Notification / SMS (optional)
# -----------------------------------------------
# Fast2SMS API key for phone OTP dispatch
FAST2SMS_API_KEY=
